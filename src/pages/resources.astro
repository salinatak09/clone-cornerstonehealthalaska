---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Resources | CORNERSTONE HEALTH"
  description="Access patient resources, insurance info, forms, and guides to prepare for your appointment at Cornerstone Health in Anchorage."
  canonical="https://cornerstonehealthalaska.org/resources/"
  ogImage="https://cornerstonehealthalaska.org/wp-content/uploads/Mask-group.png"
>
  <Header />

  <main>
    <!-- Page Hero -->
    <section class="page-hero" aria-label="Resources">
      <div class="page-hero-inner resources-hero-inner">
        <div class="resources-hero-content">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <span>Resources</span>
          </nav>
          <h1 class="page-hero-title">Helpful Resources</h1>
          <p class="page-hero-desc">Browse our full list of resources, including billing and insurance information for our counseling services for individuals and families in Anchorage.</p>
        </div>
        <div class="resources-hero-image">
          <img
            src="https://cornerstonehealthalaska.org/wp-content/uploads/Mask-group.png"
            alt="Group of friends smiling and celebrating together outdoors"
            width="830"
            height="491"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <!-- Billing & Payments -->
    <section class="billing-section" id="billing-payment" aria-labelledby="billing-heading">
      <div class="section-inner billing-inner">
        <div class="billing-image">
          <img
            src="https://cornerstonehealthalaska.org/wp-content/uploads/shutterstock_2113556048-scaled.jpg"
            alt="Smiling woman sitting on couch using laptop with a plant and lamp in the background"
            width="640"
            height="426"
            loading="lazy"
          />
        </div>
        <div class="billing-content">
          <span class="eyebrow-label teal">How to Pay</span>
          <h2 id="billing-heading" class="section-heading">Billing &amp; Payments</h2>
          <p class="body-text">
            For billing questions or to make a payment, please contact Spectrum Medical Billing Services. Payments can be mailed to:
          </p>
          <address class="billing-address">
            <strong>Spectrum Medical Billing Services</strong><br />
            P.O. Box 221149<br />
            Anchorage, AK 99522
          </address>
          <p class="body-text" style="margin-top: 16px;">
            For assistance over the phone, please call <a href="tel:9074405900">907-440-5900</a>. We’re here to help with any billing concerns.
          </p>
        </div>
      </div>
    </section>

    <!-- Accepted Insurances -->
    <section class="insurance-section" id="accepted-insurance" aria-labelledby="insurance-heading">
      <div class="section-inner">
        <h2 id="insurance-heading" class="section-heading centered">Accepted Insurances</h2>
        <div class="insurance-logos">
          <img src="https://cornerstonehealthalaska.org/wp-content/uploads/img-logo-blue-cross-blue-shield.svg" alt="Blue Cross Blue Shield" />
          <img src="https://cornerstonehealthalaska.org/wp-content/uploads/img-logo-aetna.jpg" alt="Aetna" />
          <img src="https://cornerstonehealthalaska.org/wp-content/uploads/im-logo-cigna-healthcare.svg" alt="Cigna" />
          <img src="https://cornerstonehealthalaska.org/wp-content/uploads/img-logo-medicare.jpg" alt="Medicare" />
          <img src="https://cornerstonehealthalaska.org/wp-content/uploads/TRICARE-Logo-Thumbnail.png" alt="Tricare" />
          <img src="https://cornerstonehealthalaska.org/wp-content/uploads/triwest-healthcare-alliance-logo-png_seeklogo-264972-600x480.png" alt="TriWest" />
          <img src="https://cornerstonehealthalaska.org/wp-content/uploads/carelon.png" alt="Carelon" />
          <img src="https://cornerstonehealthalaska.org/wp-content/uploads/MODA.png" alt="Moda" />
          <img src="https://cornerstonehealthalaska.org/wp-content/uploads/img-logo-geha.png" alt="GEHA" />
          <img src="https://cornerstonehealthalaska.org/wp-content/uploads/Optum.png" alt="Optum" />
          <img src="https://cornerstonehealthalaska.org/wp-content/uploads/United-Healthcare.png" alt="United Healthcare" />
        </div>
      </div>
    </section>

    <!-- Client Intake Forms -->
    <section class="forms-section" id="client-intake-forms" aria-labelledby="forms-heading">
      <div class="section-inner forms-inner">
        <span class="eyebrow-label teal">Start Your Visit</span>
        <h2 id="forms-heading" class="section-heading">Client Intake Forms</h2>
        <p class="body-text">
          Complete forms electronically then email them to: <a href="mailto:info@cornerstonehealthalaska.org">info@cornerstonehealthalaska.org</a> or bring <strong>printed, signed copies to your appointment</strong>. Signing will be completed in person.
        </p>
        <p class="body-text">
          Prior to scheduling an appointment, click on the intake packet buttons below to complete our new client intake form. Once the form is complete, you can either email or fax it to the clinic.
        </p>

        <div class="forms-grid">
          <a href="https://cornerstonehealthalaska.org/wp-content/uploads/Adult-Intake-Packet.pdf" class="form-btn" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Printable Adult Intake Packet
          </a>
          <a href="https://cornerstonehealthalaska.org/wp-content/uploads/Child-Adolescent-Intake-Packet.pdf" class="form-btn" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Child &amp; Adolescent Intake Packet
          </a>
          <a href="https://cornerstonehealthalaska.org/wp-content/uploads/Sliding-Fee-Discount-Application.pdf" class="form-btn" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Sliding Fee Discount Application
          </a>
          <a href="https://cornerstonehealthalaska.org/wp-content/uploads/ROI_CMC_to_self.pdf" class="form-btn" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Authorization to Release &amp; Disclose Patient Info
          </a>
        </div>

        <div class="medical-records-info" style="margin-top: 40px;">
          <p class="body-text" style="font-size: 14px; color: #666; line-height: 1.6;">
            To request Cornerstone Health Medical records, please complete the Authorization to Release and Disclose Patient Information and return to the front desk staff either in-person or via fax at <a href="tel:9075227088">(907) 522-7088</a>. If you would like digitized records, please provide a USB flash drive. For any questions or concerns regarding medical records, please call <a href="tel:9075227080">(907) 522-7080</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQs -->
    <section class="faq-section" id="faqs" aria-labelledby="faq-heading">
      <div class="section-inner faq-inner">
        <span class="eyebrow-label centered">About Counseling at CHA</span>
        <h2 id="faq-heading" class="section-heading centered">Frequently Asked Questions</h2>

        <div class="faq-accordion">
          <details class="faq-item">
            <summary class="faq-question">
              <span>Do I need to be a Christian to receive care at Cornerstone Health?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>No. While we are a faith-based organization, we welcome and serve individuals from all backgrounds, beliefs, and walks of life.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>How do I know which service is right for me?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Our front office staff can help guide you based on your needs. We may recommend a consultation or connect you with the appropriate provider.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Can I request a specific provider or counselor?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Yes, you may request a provider. If your preferred provider is unavailable, we’ll work to find someone with a similar approach and availability.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Do you offer telehealth appointments?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Yes. We offer virtual appointments for select counseling services. Contact us to find out if telehealth is available for your care needs.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>What should I bring to my first appointment?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Please bring your ID, insurance card, completed intake forms (if possible), and a list of current medications or relevant health information.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Do you accept Medicare &amp; Medicaid?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>We take Medicare, but do not accept Medicaid. Please check out our <a href="#accepted-insurance">accepted insurances</a> for more information.</p>
            </div>
          </details>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Resources Hero specific layout */
  .resources-hero-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .resources-hero-image img {
    border-radius: 20px;
    width: 100%;
  }

  .billing-section {
    padding: 80px 0;
    background: #fff;
  }
  .billing-inner {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: center;
  }
  .billing-image img {
    border-radius: 20px;
    width: 100%;
  }
  .billing-address {
    font-style: normal;
    font-size: 14px;
    line-height: 1.6;
    color: #444;
    border-left: 3px solid #1a6b72;
    padding-left: 12px;
    margin-top: 12px;
  }

  /* Insurances logo layout */
  .insurance-section {
    padding: 80px 0;
    background: #f8f8f8;
  }
  .insurance-logos {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 32px;
    margin-top: 40px;
    align-items: center;
    justify-items: center;
  }
  .insurance-logos img {
    max-width: 120px;
    height: auto;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.7;
    transition: all 0.2s;
  }
  .insurance-logos img:hover {
    filter: none;
    opacity: 1;
  }

  /* Client Intake Forms */
  .forms-section {
    padding: 80px 0;
    background: #fff;
  }
  .forms-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 32px;
  }
  .form-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: #1a6b72;
    color: #fff;
    text-decoration: none;
    padding: 16px 24px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 14px;
    text-align: center;
    transition: background 0.2s, transform 0.15s;
    box-shadow: 0 4px 12px rgba(26,107,114,0.15);
  }
  .form-btn:hover {
    background: #135258;
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .resources-hero-inner {
      grid-template-columns: 1fr;
    }
    .billing-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .insurance-logos {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    .forms-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .insurance-logos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
