---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="About Us | CORNERSTONE HEALTH"
  description="Discover faith-based counseling in Anchorage, where individuals and families can find hope, healing, and support."
  canonical="https://cornerstonehealthalaska.org/about/"
  ogImage="/images/Union.png"
>
  <Header />

  <main>
    <!-- Page Hero -->
    <section class="page-hero" aria-label="About Us">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span>About</span>
        </nav>
        <h1 class="page-hero-title">About Us</h1>
        <p class="page-hero-desc">Discover faith-based counseling in Anchorage, where individuals and families can find hope, healing, and support.</p>
      </div>
      <div class="page-hero-image">
        <img
          src="/images/about-us-banner.webp"
          alt="Two people walking together outdoors"
          width="400"
          height="340"
          loading="lazy"
        />
      </div>
    </section>

    <!-- Who We Are -->
    <section class="about-who" aria-labelledby="who-we-are">
      <div class="section-inner about-who-inner">
        <div class="about-who-image">
          <img
            src="/images/Serving-Anchorage-with-Care-for-All-Ages.webp"
            alt="Two men smiling together outdoors"
            width="400"
            height="340"
            loading="lazy"
          />
        </div>
        <div class="about-who-content">
          <span class="eyebrow-label teal">WHO WE ARE</span>
          <h2 id="who-we-are" class="section-heading">Serving Anchorage with Care for All Ages</h2>
          <p class="body-text">
            Cornerstone Health is a faith-based nonprofit health care organization in Anchorage, Alaska. Through our Counseling Clinic, we offer compassionate mental health counseling that honors the dignity of every person.
          </p>
          <p class="body-text" style="color: #1a6b72;">
            Our approach focuses on supporting the heart, mind, and spirit, guided by Christ's example of compassion and care.
          </p>
        </div>
      </div>
      <div class="pillars-grid">
        <div class="pillar">
          <h3 class="pillar-title">Guided by faith</h3>
          <p class="pillar-desc" style="color: #1a6b72;">Creating a healthier community by delivering compassionate, Christ-centered care that heals body, mind, and spirit.</p>
        </div>
        <div class="pillar">
          <h3 class="pillar-title">Committed to care</h3>
          <p class="pillar-desc">Nurturing individuals and caregivers through quality care, education, and supportive services, locally and statewide.</p>
        </div>
        <div class="pillar">
          <h3 class="pillar-title">Focused on people</h3>
          <p class="pillar-desc">Serving with compassion, integrity, and faith to deliver excellent care through grace-filled, collaborative relationships.</p>
        </div>
      </div>
    </section>

    <!-- Meet Our Team -->
    <section class="team-section" id="our-team" aria-labelledby="team-heading">
      <div class="section-inner">
        <div class="team-header">
          <span class="eyebrow-label centered teal">GUIDED BY PURPOSE</span>
          <h2 id="team-heading" class="section-heading centered">Meet Our Team</h2>
          <p class="section-subtext centered" style="max-width:900px">
            Get to know the dedicated providers, counselors, and staff behind Cornerstone Health, each committed to delivering compassionate, faith-informed care to the Anchorage community.
          </p>
        </div>

        <div class="team-grid">
          <article class="team-card">
            <img
              src="/images/Beth_Hopkins-2-e1754493334331-768x768.jpg"
              alt="Beth Hopkins"
              width="220"
              height="220"
              loading="lazy"
            />
            <h3 class="team-name">Beth Hopkins</h3>
            <p class="team-role">Professional Counselor</p>
          </article>

          <article class="team-card">
            <img
              src="/images/img-team-katya-kennedy-768x768.jpg"
              alt="Katya Kennedy"
              width="220"
              height="220"
              loading="lazy"
            />
            <h3 class="team-name">Katya Kennedy</h3>
            <p class="team-role">Master's Level Counselor</p>
          </article>

          <article class="team-card">
            <img
              src="/images/Linda_King-2-e1754586899166-768x756.jpg"
              alt="Linda King"
              width="220"
              height="220"
              loading="lazy"
            />
            <h3 class="team-name">Linda King</h3>
            <p class="team-role">Marriage &amp; Family Counselor</p>
          </article>

          <article class="team-card">
            <img
              src="/images/Suki_Lewis-2-e1755529254402-768x768.jpg"
              alt="Suki Lewis, PsyD"
              width="220"
              height="220"
              loading="lazy"
            />
            <h3 class="team-name">Suki Lewis, PsyD</h3>
            <p class="team-role">Clinical Psychologist</p>
          </article>

          <article class="team-card">
            <img
              src="/images/Sarah_Mills-2-scaled-e1754493148312-768x768.jpg"
              alt="Sarah Mills"
              width="220"
              height="220"
              loading="lazy"
            />
            <h3 class="team-name">Sarah Mills</h3>
            <p class="team-role">Professional Counselor, Program Administrator</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Privacy Section -->
    <section class="privacy-section" id="client-privacy" aria-labelledby="privacy-heading">
      <div class="section-inner privacy-inner">
        <div class="privacy-image">
          <img
            src="/images/shutterstock_2576156461-scaled.jpg"
            alt="Person in outdoor nature setting"
            width="400"
            height="340"
            loading="lazy"
          />
        </div>
        <div class="privacy-content">
          <span class="eyebrow-label teal">CONFIDENTIAL CARE</span>
          <h2 id="privacy-heading" class="section-heading">Our Commitment to Client Privacy</h2>
          <p class="body-text">
            Your privacy is important to us. All client information is kept strictly confidential in accordance with HIPAA regulations and Alaska state law. We are committed to maintaining the highest standards of privacy and confidentiality.
          </p>
          <a href="/privacy-policy/" class="btn-hero" id="hero-get-started">Learn more</a>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <Testimonials
      imageSrc="/images/about-testimonial.webp"
      imageAlt="Smiling man with his Children looking at a laptop"
      quote="They are very friendly and can get me in same day most of the time. The doctor is compassionate and informative. I'd recommend them to anyone looking for a good doctor and nursing staff!"
      author="Medical Client"
    />

    <!-- CTA Section -->
    <CTASection
      imageSrc="/images/Find-the-Right-Fit-for-Your-Care.png"
      altText="Smiling woman sitting on a couch using a laptop"
      title="Ready to take the next step?"
      description="Schedule an appointment with one of our compassionate providers today and begin your journey toward healing and growth."
    />
  </main>

  <Footer />
</Layout>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 0;
    font-family: 'Manrope', sans-serif;
    color: #030320;
    background: #fff;
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; height: auto; display: block; }


  /* Page Hero */

  .page-hero-title { 
    font-family: 'Montserrat', sans-serif; 
    font-size: clamp(32px, 5vw, 64px); 
    font-weight: 700; 
    color: #fff; 
    margin: 0 0 12px; 
  }
  .page-hero-desc { 
    font-size: 18px; 
    font-weight: 500;
    color: rgba(255,255,255,0.85); 
    margin: 0; 
    max-width: 500px; 
    line-height: 1.6; 
  }

  .page-hero-image img { 
    width: 100%; 
    max-height: 400px;
    object-fit: cover;
  }

  /* About Who We Are */
  .about-who { 
    padding: 80px 0;
    background: #f1f9fa;
  }
  .about-who-inner { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 60px; 
    align-items: start; 
  }
  .about-who-image img { border-radius: 16px; width: 100%; }

  .pillars-grid { 
    display: grid; 
    grid-template-columns: repeat(3, 1fr); 
    gap: 40px; 
    margin: 40px;
  }

  .pillar{
    padding: 20px;
  }

  .pillar-title { 
    font-family: 'Montserrat', sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: #0b2545;
    margin: 0 0 8px;
  }
  .pillar-desc { 
    font-size: 18px;
    line-height: 1.6;
    color: #555;
    margin: 0;
  }

  /* Team */
  .team-section { padding: 80px 0; background: #fff; }
  .team-header { text-align: center; margin-bottom: 40px; font-size: 46px; }
  .team-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
  .team-card { text-align: center; }
  .team-card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; margin-bottom: 12px; }
  .team-name { font-family: 'Montserrat', sans-serif; font-size: 20px; font-weight: 700; color: #0b2545; margin: 0 0 4px; }
  .team-role { font-size: 18px; color: #666; margin: 0; }

  /* Privacy */
  .privacy-section { padding: 80px 0; }
  .privacy-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start; }
  .privacy-image img { border-radius: 16px; width: 100%; }

  @media (max-width: 1024px) {
    .about-who-inner { grid-template-columns: 1fr; }
    .team-grid { grid-template-columns: repeat(3, 1fr); }
    .privacy-inner { grid-template-columns: 1fr; }
    .pillars-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .team-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
