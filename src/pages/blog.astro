---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="Blog | CORNERSTONE HEALTH"
  description="Read our blog for health and counseling insights. Stay updated with expert advice on wellness and mental health."
  canonical="https://cornerstonehealthalaska.org/blog/"
  ogImage="/images/Union.png"
>
  <Header />

  <main>
    <!-- Page Hero -->
    <section class="page-hero" aria-label="Blog">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span>Blog</span>
        </nav>
        <h1 class="page-hero-title">Our Blog</h1>
        <p class="page-hero-desc">Looking for inspirational and insightful reads in all things mental health and healthcare? Check out our blog!</p>
      </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="blog-grid-section" aria-label="Blog posts list">
      <div class="section-inner">
        <div class="blog-grid">
          <!-- Post 1 -->
          <article class="blog-card">
            <a href="https://cornerstonehealthalaska.org/how-couples-counseling-can-help-restore-connection/" class="blog-card-image-link">
              <img
                src="/images/Cornerstone_CouplesCounseling_Image-1-980x480.png"
                alt="Couples counseling"
                width="980"
                height="480"
                loading="lazy"
              />
            </a>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="blog-category">Uncategorized</span>
                <span class="blog-date">November 20, 2025</span>
              </div>
              <h2 class="blog-card-title">
                <a href="https://cornerstonehealthalaska.org/how-couples-counseling-can-help-restore-connection/">
                  How Couples Counseling Can Help Restore Connection
                </a>
              </h2>
              <a href="https://cornerstonehealthalaska.org/how-couples-counseling-can-help-restore-connection/" class="read-more-link">
                <span>Read More</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none"><path d="M12.1289 1.00537C12 0.876465 11.8477 0.812012 11.6719 0.812012C11.4961 0.812012 11.3438 0.876465 11.2148 1.00537C11.0859 1.12256 11.0215 1.26904 11.0215 1.44482C11.0215 1.62061 11.0859 1.77295 11.2148 1.90186L15.8203 6.50732H0.632812C0.457031 6.50732 0.307617 6.56885 0.18457 6.69189C0.0615234 6.81494 0 6.96436 0 7.14014C0 7.31592 0.0615234 7.46533 0.18457 7.58838C0.307617 7.71143 0.457031 7.77295 0.632812 7.77295H15.8203L11.2148 12.3784C11.0859 12.4956 11.0215 12.645 11.0215 12.8267C11.0215 13.0083 11.0859 13.1577 11.2148 13.2749C11.3438 13.4038 11.4961 13.4683 11.6719 13.4683C11.8477 13.4683 12 13.4038 12.1289 13.2749L17.8066 7.59717C17.9355 7.46826 18 7.31592 18 7.14014C18 6.96436 17.9355 6.81201 17.8066 6.68311L12.1289 1.00537Z" fill="#F36E24"/></svg>
              </a>
            </div>
          </article>

          <!-- Post 2 -->
          <article class="blog-card">
            <a href="https://cornerstonehealthalaska.org/should-i-worry-or-not-how-to-recognize-anxiety-in-kids-teens/" class="blog-card-image-link">
              <img
                src="/images/Cornerstone_AnxietyinKidsTeens_Image-980x480.png"
                alt="Anxiety in kids and teens"
                width="980"
                height="480"
                loading="lazy"
              />
            </a>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="blog-category">Uncategorized</span>
                <span class="blog-date">November 20, 2025</span>
              </div>
              <h2 class="blog-card-title">
                <a href="https://cornerstonehealthalaska.org/should-i-worry-or-not-how-to-recognize-anxiety-in-kids-teens/">
                  Should I Worry or Not? How to Recognize Anxiety in Kids &amp; Teens
                </a>
              </h2>
              <a href="https://cornerstonehealthalaska.org/should-i-worry-or-not-how-to-recognize-anxiety-in-kids-teens/" class="read-more-link">
