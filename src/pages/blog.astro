              </a>
            </div>
          </article>

          <!-- Post 5 -->
          <article class="blog-card">
            <a href="https://cornerstonehealthalaska.org/managing-anxiety-and-stress-in-alaskas-unique-environment/" class="blog-card-image-link">
              <img
                src="/images/shutterstock_1827084839-980x480.jpg"
                alt="Hikers along forest trail"
                width="980"
                height="480"
                loading="lazy"
              />
            </a>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="blog-category">Uncategorized</span>
                <span class="blog-date">July 8, 2025</span>
              </div>
