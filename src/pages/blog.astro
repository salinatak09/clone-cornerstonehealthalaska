                width="980"
                height="480"
                loading="lazy"
              />
            </a>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="blog-category">Uncategorized</span>
                <span class="blog-date">July 8, 2025</span>
              </div>
              <h2 class="blog-card-title">
                <a href="https://cornerstonehealthalaska.org/what-to-expect-during-your-first-appointment-at-cornerstone-health/">
                  What to Expect During Your First Appointment at Cornerstone Health
                </a>
              </h2>
              <a href="https://cornerstonehealthalaska.org/what-to-expect-during-your-first-appointment-at-cornerstone-health/" class="read-more-link">
                <span>Read More</span>
