---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Terms & Services | CORNERSTONE HEALTH"
  description="Read the Terms and Services for Cornerstone Health Alaska."
  canonical="https://cornerstonehealthalaska.org/terms-services/"
  ogImage="https://cornerstonehealthalaska.org/wp-content/uploads/Union.png"
>
  <Header />

  <main>
    <!-- Page Hero -->
    <section class="page-hero" aria-label="Terms and Services">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span>Terms &amp; Services</span>
        </nav>
        <h1 class="page-hero-title">Terms &amp; Services</h1>
      </div>
    </section>

    <section class="legal-content-section">
      <div class="section-inner legal-content">
        <h2>Terms of Service</h2>
        <p>Welcome to Cornerstone Health. By accessing or using our website and services, you agree to comply with and be bound by the following terms and conditions.</p>

        <h3>Use of Website</h3>
        <p>The content provided on this website is for informational purposes only and is not intended as medical advice, diagnosis, or treatment. Always seek the advice of a qualified healthcare provider with any questions you may have regarding a medical condition.</p>

        <h3>Appointments & Cancellations</h3>
        <p>Clients are expected to provide at least 24 hours notice for any appointment cancellations or reschedules. Failure to provide timely notice may result in cancellation fees.</p>

        <h3>Intellectual Property</h3>
        <p>All trademarks, logos, service marks, and content displayed on this website belong to Cornerstone Health and may not be reproduced without prior written permission.</p>

        <h3>Changes to Terms</h3>
        <p>Cornerstone Health reserves the right to modify these terms at any time. Continued use of our website or services constitutes acceptance of any updated terms.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
