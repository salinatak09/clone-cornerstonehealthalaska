---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import BlogSection from '../components/BlogSection.astro';
---

<Layout
  title="Home | CORNERSTONE HEALTH"
  description="Faith-based counseling services in Anchorage offering support for individuals, couples, and families. Schedule an appointment today."
  canonical="https://cornerstonehealthalaska.org/"
  ogImage="/images/Union.png"
>
  <Header />

  <main>
    <!-- ===== HERO SECTION ===== -->
    <section class="hero" aria-label="Welcome to Cornerstone Health">
      <div class="hero-inner">
        <div class="hero-content">
          <p class="hero-eyebrow">WELCOME TO</p>
          <h1 class="hero-title">
            Counseling for
            Whole-Person
            Wellness<br />
            in Anchorage
          </h1>
          <p class="hero-desc">
            Compassionate counseling support for<br />
            individuals and families in Anchorage,<br />
            AK.
          </p>
          <a href="/contact/" class="btn-hero" id="hero-get-started">Get Started</a>
        </div>
        <div class="hero-image-wrap">
          <div class="hero-image-circle">
            <img
              src="/images/Union.png"
              alt="Three young women laughing and enjoying time together outdoors"
              width="560"
              height="480"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ===== SERVICE CARDS SECTION ===== -->
    <section class="services-section" aria-label="Our counseling services">
      <div>
        <div class="services-grid">
          <!-- Card 1 -->
          <article class="service-card">
            <h2 class="service-card-title">Individuals</h2>
            <hr class="service-divider" />
            <p>Get one-on-one counseling designed to help you heal, grow, and move forward with confidence.</p>
          </article>
          <!-- Card 2 -->
          <article class="service-card">
            <h2 class="service-card-title">Couples</h2>
            <hr class="service-divider" />
            <p>Offering supportive counseling for couples seeking deeper understanding &amp; trust.</p>
          </article>
          <!-- Card 3 -->
          <article class="service-card">
            <h2 class="service-card-title">Family</h2>
            <hr class="service-divider" />
            <p>Relax in a safe space for your family to grow closer, work through challenges, and build resilience together.</p>
          </article>
          <!-- Card 4 -->
          <article class="service-card">
            <h2 class="service-card-title">Teens/Young Adults</h2>
            <hr class="service-divider" />
            <p>Here to help with school stress, emotional overwhelm, and more.</p>
          </article>
        </div>

        <div class="services-cta">
          <a href="/services/counseling/" class="btn-cta-lg" id="learn-more-counseling">Learn More About Our Counseling Services</a>
        </div>
      </div>
    </section>

    <!-- ===== EXPERTISE SECTION ===== -->
    <section class="expertise-section" aria-label="Our expertise">
      <div class="expertise-inner">
        <!-- Image left -->
        <div class="expertise-image">
          <img
            src="/images/Unmatched-Expertise.png"
            alt="Smiling older woman with glasses using a smartphone at home"
            width="595"
            height="680"
            loading="lazy"
          />
        </div>

        <!-- Text right -->
        <div class="expertise-content">
          <span class="eyebrow-label">Unmatched Expertise</span>
          <h2 class="section-heading">
            Compassionate, Faith-Inspired Care for the Whole Family
          </h2>
          <p class="body-text">
            For over 30 years, Cornerstone Health has served the Anchorage community with a relational, Christ-centered approach to healing. Through our Counseling Clinic, we provide compassionate mental health support and faith-based counseling services for individuals and families seeking hope, growth, and restoration.
          </p>
          <p class="cta-question"><strong>Ready to feel truly heard and cared for?</strong></p>
          <a href="/about/" class="btn-orange-lg" id="expertise-explore-more">EXPLORE MORE</a>

          <!-- Feature list -->
          <div class="feature-lists">
            <ul class="feature-list">
              <li>
                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
                Trusted Experts
              </li>
              <li>
                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
                Personalized Solutions
              </li>
              <li>
                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
                Rapid Response
              </li>
            </ul>
            <ul class="feature-list">
              <li>
                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
                Dedicated Team
              </li>
              <li>
                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
                Advanced Techniques
              </li>
              <li>
                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
                Happy Clients
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== WHY CHOOSE US SECTION ===== -->
    <section class="why-section" aria-label="Why choose Cornerstone Health">
      <div class="section-inner why-inner">
        <!-- Text left -->
        <div class="why-text">
          <span class="eyebrow-label teal">SEE THE DIFFERENCE</span>
          <h2 class="why-heading">
            Why Choose<br />
            Cornerstone<br />
            Health?
          </h2>
          <p class="body-text">
            We believe health care should be deeply personal, not rushed. That's why our appointments are longer, our atmosphere is peaceful, and our care team is focused on your full story—not just your symptoms.
          </p>
          <a href="/about/" class="btn-orange-lg" id="why-explore-more">EXPLORE MORE</a>
        </div>

        <!-- Center image -->
        <div class="why-image">
          <img
            src="/images/Cornerstone.png"
            alt="Smiling family with two kids running and playing together outdoors"
            width="377"
            height="590"
            loading="lazy"
          />
        </div>

        <!-- Right list -->
        <div class="why-apart">
          <h3 class="apart-heading">What sets us apart?</h3>
          <ul class="apart-list">
            <li><p>Over <strong>30 years serving Anchorage</strong> with faith-based care</p></li>
            <li><p><strong>Licensed counseling professionals</strong> trained in evidence-based practices</p></li>
            <li><p><strong>A holistic model of care—</strong> supporting body, mind, and spirit</p></li>
            <li><p><strong>Unhurried appointments</strong> that foster real relationships</p></li>
            <li><p>Trusted by <strong>local churches, schools, and families</strong></p></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== TESTIMONIAL SECTION ===== -->
    <Testimonials
      imageSrc="/images/Testimonials-img.png"
      imageAlt="Smiling man sitting on a couch using a yellow smartphone"
      quote="From the front desk to my provider, I felt cared for every step of the way."
      author="Counseling Client"
    />

    <!-- ===== HOW IT WORKS SECTION ===== -->
    <section class="how-section" aria-label="How our process works">
      <div class="section-inner how-inner">
        <span class="eyebrow-label teal centered">OUR PROCESS</span>
        <h2 class="section-heading centered">How it Works</h2>
        <p class="section-subtext centered">
          We know reaching out for help can feel overwhelming.<br />
          That's why we make it easy. Here's how our process works:
        </p>

        <div class="how-steps">
          <!-- Step 1 -->
          <div class="how-step">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="75" height="75" viewBox="0 0 75 75" fill="none">
                <rect x="0.98" y="0.8" width="74" height="74" rx="37" fill="#6FD0D9"/>
                <path d="M31.8577 49.25C30.2577 49.25 28.8577 48.915 27.6577 48.245C26.4577 47.575 25.5227 46.64 24.8527 45.44C24.1827 44.24 23.8477 42.84 23.8477 41.24V34.76C23.8477 33.16 24.1827 31.76 24.8527 30.56C25.5227 29.36 26.4577 28.425 27.6577 27.755C28.8577 27.085 30.2577 26.75 31.8577 26.75C33.4577 26.75 34.8577 27.085 36.0577 27.755C37.2577 28.425 38.1927 29.36 38.8627 30.56C39.5327 31.76 39.8677 33.16 39.8677 34.76V41.24C39.8677 42.84 39.5327 44.24 38.8627 45.44C38.1927 46.64 37.2577 47.575 36.0577 48.245C34.8577 48.915 33.4577 49.25 31.8577 49.25ZM31.8577 45.38C32.5777 45.38 33.2277 45.21 33.8077 44.87C34.3877 44.53 34.8477 44.07 35.1877 43.49C35.5277 42.91 35.6977 42.26 35.6977 41.54V34.43C35.6977 33.71 35.5277 33.06 35.1877 32.48C34.8477 31.9 34.3877 31.44 33.8077 31.1C33.2277 30.76 32.5777 30.59 31.8577 30.59C31.1377 30.59 30.4877 30.76 29.9077 31.1C29.3277 31.44 28.8677 31.9 28.5277 32.48C28.1877 33.06 28.0177 33.71 28.0177 34.43V41.54C28.0177 42.26 28.1877 42.91 28.5277 43.49C28.8677 44.07 29.3277 44.53 29.9077 44.87C30.4877 45.21 31.1377 45.38 31.8577 45.38ZM47.2125 48.8V31.64L43.1625 34.13V29.63L47.2125 27.2H51.3825V48.8H47.2125Z" fill="#0B2545"/>
              </svg>
            </div>
            <h3 class="step-title">Intake Forms</h3>
            <p class="step-desc">Complete intake forms before your session</p>
          </div>

          <!-- Step 2 -->
          <div class="how-step">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="75" height="75" viewBox="0 0 75 75" fill="none">
                <rect x="0.98" y="0.8" width="74" height="74" rx="37" fill="#6FD0D9"/>
                <path d="M28.8998 49.25C27.2998 49.25 25.8998 48.915 24.6998 48.245C23.4998 47.575 22.5648 46.64 21.8948 45.44C21.2248 44.24 20.8898 42.84 20.8898 41.24V34.76C20.8898 33.16 21.2248 31.76 21.8948 30.56C22.5648 29.36 23.4998 28.425 24.6998 27.755C25.8998 27.085 27.2998 26.75 28.8998 26.75C30.4998 26.75 31.8998 27.085 33.0998 27.755C34.2998 28.425 35.2348 29.36 35.9048 30.56C36.5748 31.76 36.9098 33.16 36.9098 34.76V41.24C36.9098 42.84 36.5748 44.24 35.9048 45.44C35.2348 46.64 34.2998 47.575 33.0998 48.245C31.8998 48.915 30.4998 49.25 28.8998 49.25ZM28.8998 45.38C29.6198 45.38 30.2698 45.21 30.8498 44.87C31.4298 44.53 31.8898 44.07 32.2298 43.49C32.5698 42.91 32.7398 42.26 32.7398 41.54V34.43C32.7398 33.71 32.5698 33.06 32.2298 32.48C31.8898 31.9 31.4298 31.44 30.8498 31.1C30.2698 30.76 29.6198 30.59 28.8998 30.59C28.1798 30.59 27.5298 30.76 26.9498 31.1C26.3698 31.44 25.9098 31.9 25.5698 32.48C25.2298 33.06 25.0598 33.71 25.0598 34.43V41.54C25.0598 42.26 25.2298 42.91 25.5698 43.49C25.9098 44.07 26.3698 44.53 26.9498 44.87C27.5298 45.21 28.1798 45.38 28.8998 45.38ZM39.9047 48.77V45.23L48.9647 37.19C49.6447 36.59 50.1247 36.025 50.4047 35.495C50.6847 34.965 50.8247 34.47 50.8247 34.01C50.8247 33.35 50.6897 32.765 50.4197 32.255C50.1497 31.735 49.7697 31.33 49.2797 31.04C48.7897 30.74 48.2147 30.59 47.5547 30.59C46.8647 30.59 46.2547 30.75 45.7247 31.07C45.2047 31.38 44.7997 31.795 44.5097 32.315C44.2197 32.825 44.0847 33.38 44.1047 33.98H39.9047C39.9047 32.5 40.2297 31.22 40.8797 30.14C41.5297 29.06 42.4347 28.225 43.5947 27.635C44.7547 27.045 46.1047 26.75 47.6447 26.75C49.0547 26.75 50.3147 27.06 51.4247 27.68C52.5447 28.29 53.4247 29.145 54.0647 30.245C54.7047 31.345 55.0247 32.62 55.0247 34.07C55.0247 35.14 54.8747 36.03 54.5747 36.74C54.2747 37.44 53.8297 38.09 53.2397 38.69C52.6497 39.28 51.9247 39.95 51.0647 40.7L45.2147 45.83L44.8847 44.93H55.0247V48.77H39.9047Z" fill="#0B2545"/>
              </svg>
            </div>
            <h3 class="step-title">Schedule An Appointment</h3>
            <p class="step-desc">Schedule your first appointment online or by the phone</p>
          </div>

          <!-- Step 3 -->
          <div class="how-step">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="75" height="75" viewBox="0 0 75 75" fill="none">
                <rect x="0.98" y="0.8" width="74" height="74" rx="37" fill="#6FD0D9"/>
                <path d="M29.0902 49.25C27.4902 49.25 26.0902 48.915 24.8902 48.245C23.6902 47.575 22.7552 46.64 22.0852 45.44C21.4152 44.24 21.0802 42.84 21.0802 41.24V34.76C21.0802 33.16 21.4152 31.76 22.0852 30.56C22.7552 29.36 23.6902 28.425 24.8902 27.755C26.0902 27.085 27.4902 26.75 29.0902 26.75C30.6902 26.75 32.0902 27.085 33.2902 27.755C34.4902 28.425 35.4252 29.36 36.0952 30.56C36.7652 31.76 37.1002 33.16 37.1002 34.76V41.24C37.1002 42.84 36.7652 44.24 36.0952 45.44C35.4252 46.64 34.4902 47.575 33.2902 48.245C32.0902 48.915 30.6902 49.25 29.0902 49.25ZM29.0902 45.38C29.8102 45.38 30.4602 45.21 31.0402 44.87C31.6202 44.53 32.0802 44.07 32.4202 43.49C32.7602 42.91 32.9302 42.26 32.9302 41.54V34.43C32.9302 33.71 32.7602 33.06 32.4202 32.48C32.0802 31.9 31.6202 31.44 31.0402 31.1C30.4602 30.76 29.8102 30.59 29.0902 30.59C28.3702 30.59 27.7202 30.76 27.1402 31.1C26.5602 31.44 26.1002 31.9 25.7602 32.48C25.4202 33.06 25.2502 33.71 25.2502 34.43V41.54C25.2502 42.26 25.4202 42.91 25.7602 43.49C26.1002 44.07 26.5602 44.53 27.1402 44.87C27.7202 45.21 28.3702 45.38 29.0902 45.38ZM46.9951 49.19C45.9151 49.19 44.8851 48.975 43.9051 48.545C42.9251 48.105 42.0701 47.49 41.3401 46.7C40.6201 45.91 40.1051 44.98 39.7951 43.91L43.7551 42.86C43.9651 43.65 44.3751 44.265 44.9851 44.705C45.6051 45.135 46.2751 45.35 46.9951 45.35C47.6151 45.35 48.1801 45.2 48.6901 44.9C49.2101 44.6 49.6201 44.195 49.9201 43.685C50.2301 43.175 50.3851 42.61 50.3851 41.99C50.3851 41.06 50.0651 40.265 49.4251 39.605C48.7951 38.935 47.9851 38.6 46.9951 38.6C46.6951 38.6 46.4051 38.645 46.1251 38.735C45.8451 38.815 45.5751 38.93 45.3151 39.08L43.4851 35.87L50.3551 30.17L50.6551 31.04H40.6351V27.2H54.1351V31.04L48.7951 36.2L48.7651 35.06C50.0051 35.25 51.0501 35.685 51.9001 36.365C52.7601 37.035 53.4101 37.865 53.8501 38.855C54.3001 39.835 54.5251 40.88 54.5251 41.99C54.5251 43.35 54.1801 44.575 53.4901 45.665C52.8001 46.745 51.8851 47.605 50.7451 48.245C49.6051 48.875 48.3551 49.19 46.9951 49.19Z" fill="#0B2545"/>
              </svg>
            </div>
            <h3 class="step-title">Meet With A Counselor</h3>
            <p class="step-desc">Meet with your counselor to explore your goals and challenges</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BLOG SECTION ===== -->
    <BlogSection/>

    <!-- ===== CTA BANNER SECTION ===== -->
    <section class="cta-banner" aria-label="Book an appointment">
      <div class="cta-banner-inner">
        <div class="cta-banner-image">
          <img
            src="/images/cta-img.webp"
            alt="Woman smiling at laptop in a warm room"
            width="400"
            height="340"
            loading="lazy"
          />
        </div>
        <div class="cta-banner-content">
          <h2 class="cta-banner-title">
            Ready to Take the Next Step in Your Wellness Journey?
          </h2>
          <p class="cta-banner-desc">
            If you're looking for support through life's challenges, we're here to help you feel whole again.
          </p>
          <p class="cta-banner-sub"><strong>Call us today or click below to schedule your first appointment.</strong></p>
          <a href="https://cornerstonehealthalaska.org/contact/" class="btn-cta-orange" id="cta-book">BOOK AN APPOINTMENT</a>
          <a href="tel:907-522-7080" class="cta-phone">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            Counseling (907) 522-7080
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: 'Manrope', sans-serif;
    color: #030320;
    background: #fff;
    -webkit-font-smoothing: antialiased;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* ===== SHARED ===== */
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .eyebrow-label {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #f36e24;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .eyebrow-label.teal { color: #1a6b72; }
  .eyebrow-label.centered { text-align: center; }

  .section-heading {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(28px, 3.5vw, 56px);
    font-weight: 700;
    color: #0b2545;
    margin: 0 0 20px;
    line-height: 1.2;
  }

  .section-heading.centered { text-align: center; }

  .section-subtext {
    font-size: 20px;
    color: #555;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .section-subtext.centered { text-align: center; }

  .body-text {
    font-size: 18px;
    letter-spacing: 0.5px;
    line-height: 1.7;
    color: #5e6b71;
    margin-bottom: 16px;
  }

  /* Buttons */
  .btn-hero {
    display: inline-flex;
    align-items: center;
    background: #f58320;
    color: #fff;
    text-decoration: none;
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 32px;
    border-radius: 50px;
    margin-top: 24px;
  }

  .btn-orange-lg {
    display: inline-flex;
    align-items: center;
    background: #f58320;
    color: #fff;
    text-decoration: none;
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    font-weight: 700;
    padding: 12px 28px;
    border-radius: 50px;
    letter-spacing: 0.5px;
  }

  .btn-cta-lg {
    display: inline-flex;
    align-items: center;
    background: #f58320;
    color: #fff;
    text-decoration: none;
    font-family: 'Manrope', sans-serif;
    font-size: 16px;
    font-weight: 700;
    padding: 16px 40px;
    border-radius: 50px;
  }

  /* ===== HERO ===== */
  .hero {
    position: relative;
    overflow: hidden;
    background-image: url("/images/crnstnhealth-Hero-banner.png");
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    width: 100%;
    height: auto;
    max-height: 820px;
  }

  .hero-inner {
    width: 100%;
    margin: 0 auto;
    padding: 60px 0 60px 40px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    position: relative;
    z-index: 2;
  }

