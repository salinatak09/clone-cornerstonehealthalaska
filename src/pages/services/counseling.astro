---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Counseling | CORNERSTONE HEALTH"
  description="Professional counseling in Anchorage. Support for individuals, couples, and families navigating anxiety, trauma, depression, and more."
  canonical="https://cornerstonehealthalaska.org/services/counseling/"
  ogImage="https://cornerstonehealthalaska.org/wp-content/uploads/What-Is-Christian-Counseling.png"
>
  <Header />

  <main>
    <!-- Page Hero -->
    <section class="page-hero" aria-label="Counseling Services">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/services/counseling/">Health services</a>
          <span>/</span>
          <span>Counseling</span>
        </nav>
        <h1 class="page-hero-title">Christian Counseling Services in Anchorage</h1>
        <p class="page-hero-desc">Our licensed therapists offer professional mental health support for children and adults in Anchorage in a warm, non-judgmental setting, welcoming clients of all faiths and backgrounds.</p>
      </div>
    </section>

    <!-- What Is Christian Counseling -->
    <section class="counseling-about" aria-labelledby="about-heading">
      <div class="section-inner counseling-about-inner">
        <div class="counseling-about-image">
          <img
            src="https://cornerstonehealthalaska.org/wp-content/uploads/What-Is-Christian-Counseling.png"
            alt="Person turning pages of an open book while reading"
            width="595"
            height="564"
            loading="lazy"
          />
        </div>
        <div class="counseling-about-content">
          <span class="eyebrow-label teal">Faith-Based Support</span>
          <h2 id="about-heading" class="section-heading">What Is Christian Counseling?</h2>
          <p class="body-text">
            At Cornerstone Health, our counseling integrates clinically proven therapeutic methods with a Christ-centered worldview. Our therapists are licensed professionals who use evidence-based practices to help clients address emotional, relational, and psychological struggles while honoring their values and beliefs.
          </p>
          <p class="body-text">
            Whether you’re seeking healing from past trauma or navigating a difficult season in marriage or parenting, our counseling team is here to help.
          </p>
          <a href="/about/" class="btn-orange-lg" style="margin-top: 16px;">LEARN MORE</a>
        </div>
      </div>
    </section>

    <!-- Who We Care For -->
    <section class="who-care" aria-labelledby="care-heading">
      <div class="section-inner who-care-inner">
        <div class="who-care-content">
          <span class="eyebrow-label teal">Grace Meets Need</span>
          <h2 id="care-heading" class="section-heading">Who We Care For</h2>
          <p class="body-text">
            Our counseling services are designed for people of all ages and stages of life.
          </p>
          
          <ul class="care-list">
            <li><p><strong>Individuals</strong> facing anxiety, depression, grief, trauma, or stress</p></li>
            <li><p><strong>Couples</strong> working through communication issues, conflict, or infidelity</p></li>
            <li><p><strong>Families</strong> struggling with parenting challenges, loss, or life transitions</p></li>
            <li><p><strong>Teens and young adults</strong> experiencing identity questions, school stress, or emotional overwhelm</p></li>
            <li><p><strong>Anyone seeking guidance</strong> that honors both faith and mental health</p></li>
          </ul>

          <a href="/about/" class="btn-orange-lg" style="margin-top: 24px;">LEARN MORE</a>
        </div>
        <div class="who-care-image">
          <img
            src="https://cornerstonehealthalaska.org/wp-content/uploads/Who-We-Care-For.png"
            alt="Smiling woman holding a red mug while standing in a modern kitchen"
            width="377"
            height="465"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- Benefits of Counseling -->
    <section class="benefits-section" aria-labelledby="benefits-heading">
      <div class="section-inner benefits-inner">
        <div class="benefits-content">
          <span class="eyebrow-label">Experience Compassionate Care</span>
          <h2 id="benefits-heading" class="section-heading">Key Benefits of Counseling</h2>
          
          <ul class="benefits-list">
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
              <span><strong>Evidence-based care</strong> from licensed therapists (PhD and master’s level)</span>
            </li>
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
              <span><strong>A compassionate space</strong> to process pain, stress, and big life changes</span>
            </li>
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
              <span><strong>Faith-aligned guidance</strong> for those who want spiritual integration</span>
            </li>
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
              <span><strong>Support for marriages, families, and individuals</strong></span>
            </li>
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
              <span><strong>Peace of mind</strong> knowing your values are respected and your healing matters</span>
            </li>
          </ul>
        </div>
        <div class="benefits-image">
          <img
            src="https://cornerstonehealthalaska.org/wp-content/uploads/Key-Benefits-of-Counseling.png"
            alt="Smiling older couple enjoying coffee together at home"
            width="595"
            height="502"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="how-section" aria-label="How our process works">
      <div class="section-inner how-inner">
        <span class="eyebrow-label centered">OUR PROCESS</span>
        <h2 class="section-heading centered">How it Works</h2>
        <p class="section-subtext centered">
          We know reaching out for help can feel overwhelming.<br />
          That's why we make it easy. Here's how our process works:
        </p>

        <div class="how-steps">
          <div class="how-step">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="75" height="75" viewBox="0 0 75 75" fill="none">
                <rect x="0.98" y="0.8" width="74" height="74" rx="37" fill="#6FD0D9"/>
                <path d="M31.8577 49.25C30.2577 49.25 28.8577 48.915 27.6577 48.245C26.4577 47.575 25.5227 46.64 24.8527 45.44C24.1827 44.24 23.8477 42.84 23.8477 41.24V34.76C23.8477 33.16 24.1827 31.76 24.8527 30.56C25.5227 29.36 26.4577 28.425 27.6577 27.755C28.8577 27.085 30.2577 26.75 31.8577 26.75C33.4577 26.75 34.8577 27.085 36.0577 27.755C37.2577 28.425 38.1927 29.36 38.8627 30.56C39.5327 31.76 39.8677 33.16 39.8677 34.76V41.24C39.8677 42.84 39.5327 44.24 38.8627 45.44C38.1927 46.64 37.2577 47.575 36.0577 48.245C34.8577 48.915 33.4577 49.25 31.8577 49.25ZM31.8577 45.38C32.5777 45.38 33.2277 45.21 33.8077 44.87C34.3877 44.53 34.8477 44.07 35.1877 43.49C35.5277 42.91 35.6977 42.26 35.6977 41.54V34.43C35.6977 33.71 35.5277 33.06 35.1877 32.48C34.8477 31.9 34.3877 31.44 33.8077 31.1C33.2277 30.76 32.5777 30.59 31.8577 30.59C31.1377 30.59 30.4877 30.76 29.9077 31.1C29.3277 31.44 28.8677 31.9 28.5277 32.48C28.1877 33.06 28.0177 33.71 28.0177 34.43V41.54C28.0177 42.26 28.1877 42.91 28.5277 43.49C28.8677 44.07 29.3277 44.53 29.9077 44.87C30.4877 45.21 31.1377 45.38 31.8577 45.38ZM47.2125 48.8V31.64L43.1625 34.13V29.63L47.2125 27.2H51.3825V48.8H47.2125Z" fill="#0B2545"/>
              </svg>
            </div>
            <h3 class="step-title">Complete Intake Forms</h3>
            <p class="step-desc">Complete intake forms before your session</p>
          </div>

          <div class="how-step">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="75" height="75" viewBox="0 0 75 75" fill="none">
                <rect x="0.98" y="0.8" width="74" height="74" rx="37" fill="#6FD0D9"/>
                <path d="M28.8998 49.25C27.2998 49.25 25.8998 48.915 24.6998 48.245C23.4998 47.575 22.5648 46.64 21.8948 45.44C21.2248 44.24 20.8898 42.84 20.8898 41.24V34.76C20.8898 33.16 21.2248 31.76 21.8948 30.56C22.5648 29.36 23.4998 28.425 24.6998 27.755C25.8998 27.085 27.2998 26.75 28.8998 26.75C30.4998 26.75 31.8998 27.085 33.0998 27.755C34.2998 28.425 35.2348 29.36 35.9048 30.56C36.5748 31.76 36.9098 33.16 36.9098 34.76V41.24C36.9098 42.84 36.5748 44.24 35.9048 45.44C35.2348 46.64 34.2998 47.575 33.0998 48.245C31.8998 48.915 30.4998 49.25 28.8998 49.25ZM28.8998 45.38C29.6198 45.38 30.2698 45.21 30.8498 44.87C31.4298 44.53 31.8898 44.07 32.2298 43.49C32.5698 42.91 32.7398 42.26 32.7398 41.54V34.43C32.7398 33.71 32.5698 33.06 32.2298 32.48C31.8898 31.9 31.4298 31.44 30.8498 31.1C30.2698 30.76 29.6198 30.59 28.8998 30.59C28.1798 30.59 27.5298 30.76 26.9498 31.1C26.3698 31.44 25.9098 31.9 25.5698 32.48C25.2298 33.06 25.0598 33.71 25.0598 34.43V41.54C25.0598 42.26 25.2298 42.91 25.5698 43.49C25.9098 44.07 26.3698 44.53 26.9498 44.87C27.5298 45.21 28.1798 45.38 28.8998 45.38ZM39.9047 48.77V45.23L48.9647 37.19C49.6447 36.59 50.1247 36.025 50.4047 35.495C50.6847 34.965 50.8247 34.47 50.8247 34.01C50.8247 33.35 50.6897 32.765 50.4197 32.255C50.1497 31.735 49.7697 31.33 49.2797 31.04C48.7897 30.74 48.2147 30.59 47.5547 30.59C46.8647 30.59 46.2547 30.75 45.7247 31.07C45.2047 31.38 44.7997 31.795 44.5097 32.315C44.2197 32.825 44.0847 33.38 44.1047 33.98H39.9047C39.9047 32.5 40.2297 31.22 40.8797 30.14C41.5297 29.06 42.4347 28.225 43.5947 27.635C44.7547 27.045 46.1047 26.75 47.6447 26.75C49.0547 26.75 50.3147 27.06 51.4247 27.68C52.5447 28.29 53.4247 29.145 54.0647 30.245C54.7047 31.345 55.0247 32.62 55.0247 34.07C55.0247 35.14 54.8747 36.03 54.5747 36.74C54.2747 37.44 53.8297 38.09 53.2397 38.69C52.6497 39.28 51.9247 39.95 51.0647 40.7L45.2147 45.83L44.8847 44.93H55.0247V48.77H39.9047Z" fill="#0B2545"/>
              </svg>
            </div>
            <h3 class="step-title">Schedule Appointment</h3>
            <p class="step-desc">Schedule your first appointment online or by phone</p>
          </div>

          <div class="how-step">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="75" height="75" viewBox="0 0 75 75" fill="none">
                <rect x="0.98" y="0.8" width="74" height="74" rx="37" fill="#6FD0D9"/>
                <path d="M29.0902 49.25C27.4902 49.25 26.0902 48.915 24.8902 48.245C23.6902 47.575 22.7552 46.64 22.0852 45.44C21.4152 44.24 21.0802 42.84 21.0802 41.24V34.76C21.0802 33.16 21.4152 31.76 22.0852 30.56C22.7552 29.36 23.6902 28.425 24.8902 27.755C26.0902 27.085 27.4902 26.75 29.0902 26.75C30.6902 26.75 32.0902 27.085 33.2902 27.755C34.4902 28.425 35.4252 29.36 36.0952 30.56C36.7652 31.76 37.1002 33.16 37.1002 34.76V41.24C37.1002 42.84 36.7652 44.24 36.0952 45.44C35.4252 46.64 34.4902 47.575 33.2902 48.245C32.0902 48.915 30.6902 49.25 29.0902 49.25ZM29.0902 45.38C29.8102 45.38 30.4602 45.21 31.0402 44.87C31.6202 44.53 32.0802 44.07 32.4202 43.49C32.7602 42.91 32.9302 42.26 32.9302 41.54V34.43C32.9302 33.71 32.7602 33.06 32.4202 32.48C32.0802 31.9 31.6202 31.44 31.0402 31.1C30.4602 30.76 29.8102 30.59 29.0902 30.59C28.3702 30.59 27.7202 30.76 27.1402 31.1C26.5602 31.44 26.1002 31.9 25.7602 32.48C25.4202 33.06 25.2502 33.71 25.2502 34.43V41.54C25.2502 42.26 25.4202 42.91 25.7602 43.49C26.1002 44.07 26.5602 44.53 27.1402 44.87C27.7202 45.21 28.3702 45.38 29.0902 45.38ZM46.9951 49.19C45.9151 49.19 44.8851 48.975 43.9051 48.545C42.9251 48.105 42.0701 47.49 41.3401 46.7C40.6201 45.91 40.1051 44.98 39.7951 43.91L43.7551 42.86C43.9651 43.65 44.3751 44.265 44.9851 44.705C45.6051 45.135 46.2751 45.35 46.9951 45.35C47.6151 45.35 48.1801 45.2 48.6901 44.9C49.2101 44.6 49.6201 44.195 49.9201 43.685C50.2301 43.175 50.3851 42.61 50.3851 41.99C50.3851 41.06 50.0651 40.265 49.4251 39.605C48.7951 38.935 47.9851 38.6 46.9951 38.6C46.6951 38.6 46.4051 38.645 46.1251 38.735C45.8451 38.815 45.5751 38.93 45.3151 39.08L43.4851 35.87L50.3551 30.17L50.6551 31.04H40.6351V27.2H54.1351V31.04L48.7951 36.2L48.7651 35.06C50.0051 35.25 51.0501 35.685 51.9001 36.365C52.7601 37.035 53.4101 37.865 53.8501 38.855C54.3001 39.835 54.5251 40.88 54.5251 41.99C54.5251 43.35 54.1801 44.575 53.4901 45.665C52.8001 46.745 51.8851 47.605 50.7451 48.245C49.6051 48.875 48.3551 49.19 46.9951 49.19Z" fill="#0B2545"/>
              </svg>
            </div>
            <h3 class="step-title">Meet with a Counselor</h3>
            <p class="step-desc">Meet with your counselor to explore your goals and challenges</p>
          </div>
        </div>

        <div class="services-cta" style="margin-top: 40px;">
          <a href="/contact/" class="btn-cta-lg">Start Today</a>
        </div>
      </div>
    </section>

    <!-- Testimonial Section -->
    <section class="testimonial-section" aria-label="Client testimonials">
      <div class="testimonial-inner">
        <div class="testimonial-quote-wrap">
          <div class="testimonial-card">
            <span class="testimonial-label">Testimonials</span>
            <blockquote class="testimonial-quote">
              "The entire team at this clinic work together to ensure proper and timely patient care. Kind, compassionate, and thorough."
            </blockquote>
            <p class="testimonial-author">— Medical &amp; Counseling Client</p>
          </div>
        </div>
        <div class="testimonial-image">
          <img
            src="https://cornerstonehealthalaska.org/wp-content/uploads/Testimonials-img-2-2.png"
            alt="Grandfather smiling while holding a laughing toddler outdoors"
            width="741"
            height="725"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="faq-section" aria-labelledby="faq-heading">
      <div class="section-inner faq-inner">
        <span class="eyebrow-label centered">About Counseling at CHA</span>
        <h2 id="faq-heading" class="section-heading centered">Frequently Asked Questions</h2>
        
        <div class="faq-accordion">
          <details class="faq-item">
            <summary class="faq-question">
              <span>Do I have to be a Christian to receive counseling?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>No. We welcome all clients regardless of religious background or beliefs.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Is counseling covered by insurance?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Yes, we accept most major insurance plans including Medicare for counseling services.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>How long are sessions?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Most sessions are 50 minutes. Frequency depends on your needs and care plan.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Can I request a therapist who integrates faith into therapy?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Yes. Let us know your preferences when booking and we’ll match you with the right provider.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>What if I’m not sure what kind of counseling I need?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Reach out to us for a brief phone consultation. We will help determine the best counseling format for you.</p>
            </div>
          </details>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Extra page styles for counseling services page */
  .counseling-about {
    padding: 80px 0;
    background: #fff;
  }
  .counseling-about-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .counseling-about-image img {
    border-radius: 20px;
    width: 100%;
  }

  .who-care {
    padding: 80px 0;
    background: #f0f8f9;
  }
  .who-care-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .who-care-image img {
    border-radius: 20px;
    width: 100%;
  }
  .care-list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .care-list li p {
    font-size: 14px;
    line-height: 1.6;
    color: #444;
    margin: 0;
  }
  .care-list li strong {
    color: #00646e;
  }

  .benefits-section {
    padding: 80px 0;
    background: #fff;
  }
  .benefits-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .benefits-image img {
    border-radius: 20px;
