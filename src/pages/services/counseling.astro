---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Testimonials from '../../components/Testimonials.astro';
import FaqSection from '../../components/FaqSection.astro';
import CTASection from '../../components/CTASection.astro';
---

<Layout
  title="Counseling | CORNERSTONE HEALTH"
  description="Professional counseling in Anchorage. Support for individuals, couples, and families navigating anxiety, trauma, depression, and more."
  canonical="https://cornerstonehealthalaska.org/services/counseling/"
  ogImage="/images/What-Is-Christian-Counseling.png"
>
  <Header />

  <main>
    <!-- Page Hero -->
    <section class="page-hero" aria-label="Counseling Services">
      <div class="page-hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/services/counseling/">Health services</a>
          <span>/</span>
          <span>Counseling</span>
        </nav>
        <h1 class="page-hero-title">Christian Counseling Services in Anchorage</h1>
      </div>
      <div class="page-hero-content">
        <p class="page-hero-desc">Our licensed therapists offer professional mental health support for children and adults in Anchorage in a warm, non-judgmental setting, welcoming clients of all faiths and backgrounds.</p>
      </div>
    </section>

    <!-- What Is Christian Counseling -->
    <section class="counseling-about" aria-labelledby="about-heading">
      <div class="section-inner counseling-about-inner">
        <div class="counseling-about-image">
          <img
            src="/images/What-Is-Christian-Counseling.png"
            alt="Person turning pages of an open book while reading"
            width="595"
            height="564"
            loading="lazy"
          />
        </div>
        <div class="counseling-about-content">
          <span class="eyebrow-label teal">Faith-Based Support</span>
          <h2 id="about-heading" class="section-heading">What Is Christian Counseling?</h2>
          <p class="body-text">
            At Cornerstone Health, our counseling integrates clinically proven therapeutic methods with a Christ-centered worldview. Our therapists are licensed professionals who use evidence-based practices to help clients address emotional, relational, and psychological struggles while honoring their values and beliefs.
          </p>
          <p class="body-text">
            Whether you’re seeking healing from past trauma or navigating a difficult season in marriage or parenting, our counseling team is here to help.
          </p>
          <a href="/about/" class="btn-orange-lg" style="margin-top: 16px;">LEARN MORE</a>
        </div>
      </div>
    </section>

    <!-- Who We Care For -->
    <section class="who-care" aria-labelledby="care-heading">
      <div class="section-inner who-care-inner">
        <div class="who-care-content">
          <span class="eyebrow-label teal">Grace Meets Need</span>
          <h2 id="care-heading" class="section-heading">Who We Care For</h2>
          <p class="body-text">
            Our counseling services are designed for people of all ages and stages of life.
          </p>

          <a href="/about/" class="btn-orange-lg" style="margin-top: 24px;">LEARN MORE</a>
        </div>
        <div class="who-care-image">
          <img
            src="/images/Who-We-Care-For.png"
            alt="Smiling woman holding a red mug while standing in a modern kitchen"
            width="377"
            height="465"
            loading="lazy"
          />
        </div>
        <ul class="care-list">
          <li><p><strong>Individuals</strong> facing anxiety, depression, grief, trauma, or stress</p></li>
          <li><p><strong>Couples</strong> working through communication issues, conflict, or infidelity</p></li>
          <li><p><strong>Families</strong> struggling with parenting challenges, loss, or life transitions</p></li>
          <li><p><strong>Teens and young adults</strong> experiencing identity questions, school stress, or emotional overwhelm</p></li>
          <li><p><strong>Anyone seeking guidance</strong> that honors both faith and mental health</p></li>
        </ul>
      </div>
    </section>

    <!-- Benefits of Counseling -->
    <section class="benefits-section" aria-labelledby="benefits-heading">
      <div class="section-inner benefits-inner">
        <div class="benefits-content">
          <span class="eyebrow-label teal">Experience Compassionate Care</span>
          <h2 id="benefits-heading" class="section-heading">Key Benefits of Counseling</h2>
          
          <ul class="benefits-list">
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
              <span><strong>Evidence-based care</strong> from licensed therapists (PhD and master’s level)</span>
            </li>
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
              <span><strong>A compassionate space</strong> to process pain, stress, and big life changes</span>
            </li>
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
              <span><strong>Faith-aligned guidance</strong> for those who want spiritual integration</span>
            </li>
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
              <span><strong>Support for marriages, families, and individuals</strong></span>
            </li>
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="17" viewBox="0 0 20 17" fill="none"><path d="M19.0117 0.592163C13.2317 4.13616 9.03717 8.60683 7.15317 10.8505L2.5385 7.235L0.5 8.8783L8.47417 16.9878C9.84663 13.4723 14.1927 6.60196 19.5 1.72113L19.0117 0.592163Z" fill="#3AC1CD"/></svg>
              <span><strong>Peace of mind</strong> knowing your values are respected and your healing matters</span>
            </li>
          </ul>
        </div>
        <div class="benefits-image">
          <img
            src="/images/Key-Benefits-of-Counseling.png"
            alt="Smiling older couple enjoying coffee together at home"
            width="595"
            height="502"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="how-section" aria-label="How our process works">
      <div class="section-inner how-inner">
        <span class="eyebrow-label centered teal">OUR PROCESS</span>
        <h2 class="section-heading centered">How it Works</h2>
        <p class="section-subtext centered">
          We know reaching out for help can feel overwhelming.<br />
          That's why we make it easy. Here's how our process works:
        </p>

        <div class="how-steps">
          <div class="how-step">
            <div class="step-icon">01</div>
            <h3 class="step-title">Complete Intake Forms</h3>
            <p class="step-desc">Complete intake forms before your session</p>
          </div>

          <div class="how-step">
            <div class="step-icon">02</div>
            <h3 class="step-title">Schedule Appointment</h3>
            <p class="step-desc">Schedule your first appointment online or by phone</p>
          </div>

          <div class="how-step">
            <div class="step-icon">03</div>
            <h3 class="step-title">Meet with a Counselor</h3>
            <p class="step-desc">Meet with your counselor to explore your goals and challenges</p>
          </div>
        </div>

        <div class="services-cta" style="margin-top: 40px;">
          <a href="/contact/" class="btn-cta-lg">Start Today</a>
        </div>
      </div>
    </section>

    <!-- Testimonial Section -->
    <Testimonials
      imageSrc="/images/Testimonials-img-2-2.png"
      imageAlt="Smiling man with his son"
      quote="The entire team at this clinic work together to ensure proper and timely patient care. Kind, compassionate, and thorough."
      author="Medical & Counseling Client"
    />

    <!-- FAQ Accordion -->
    <section class="faq-section" aria-labelledby="faq-heading">
      <div class="section-inner faq-inner">
        <span class="eyebrow-label centered teal">About Counseling services</span>
        <h2 id="faq-heading" class="section-heading centered">Frequently Asked Questions</h2>
        
        <div class="faq-accordion">
          <details class="faq-item">
            <summary class="faq-question">
              <span>Do I have to be a Christian to receive counseling?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>No. We welcome all clients regardless of religious background or beliefs.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Is counseling covered by insurance?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Yes, we accept most major insurance plans including Medicare for counseling services.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>How long are sessions?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Most sessions are 50 minutes. Frequency depends on your needs and care plan.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Can I request a therapist who integrates faith into therapy?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Yes. Let us know your preferences when booking and we’ll match you with the right provider.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>What if I’m not sure what kind of counseling I need?</span>
              <span class="faq-icon">
                <svg class="plus-icon" viewBox="0 0 448 512" width="14"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z" fill="currentColor"/></svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p>Reach out to us for a brief phone consultation. We will help determine the best counseling format for you.</p>
            </div>
          </details>
        </div>
      </div>
    </section>
    <!-- CTA Section -->
     <CTASection
        imageSrc="/images/Start-Your-Journey-Toward-Healing-Today.webp"
        altText="Parents playing with their young child in a sunlit living room"
        title="Start Your Journey Toward Healing Today"
        description="You don’t have to walk through it alone. Whether you’re seeking clarity, relief, or deeper emotional and spiritual wellness, our counseling team is here to help."
      />
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Extra page styles for counseling services page */
  .counseling-about {
    padding: 80px 0;
    background: #f0f8f9;
  }
  .counseling-about-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .counseling-about-image img {
    border-radius: 20px;
    width: 100%;
  }

  .who-care {
    padding: 40px 0;
    background: #fff;
  }
  .who-care-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .who-care-image img {
    border-radius: 20px;
    width: 100%;
  }
  .care-list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .care-list li p {
    font-size: 18px;
    line-height: 1.6;
    color: #444;
    margin: 0;
  }
  .care-list li strong {
    color: #00646e;
  }

  .benefits-section {
    padding: 80px;
    background: #f0f8f9;
  }
  .benefits-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .benefits-image img {
    border-radius: 20px;
    width: 100%;
  }
  .benefits-list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    letter-spacing: 0.2px;
  }
  .benefits-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 18px;
    line-height: 1.6;
    color: #444;
  }
  .benefits-list li span strong {
    color: #0b2545;
  }

  /* Accordion styles */
  .faq-section {
    padding: 80px 0;
    background: #f8f8f8;
  }
  .faq-accordion {
    max-width: 900px;
    margin: 40px auto 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .faq-item {
    background: #c8e9ed;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    overflow: hidden;
  }
  .faq-question {
    padding: 24px;
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #0b2545;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    transition: transform 0.2s;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-answer {
    padding: 0 24px 20px;
    font-size: 16px;
    line-height: 1.6;
    color: #555;
    border-top: 1px solid #f0f0f0;
    padding-top: 16px;
  }
  .faq-answer p { margin: 0; }

  @media (max-width: 1024px) {
    .counseling-about-inner, .who-care-inner, .benefits-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .who-care-image { order: -1; }
  }
</style>
