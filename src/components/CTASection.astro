---
interface Props{
  imageSrc?: string;
  altText?: string;
  title?: string;
  description?: string;
  subDescription?: string;
}

const { imageSrc, altText, title, description, subDescription } = Astro.props;
---

<section class="cta-banner" aria-label="Book an appointment">
  <div class="cta-banner-inner">
    <div class="cta-banner-image">
      <img
        src={imageSrc || '/images/Find-the-Right-Fit-for-Your-Care.png'}
        alt={altText || 'Smiling woman sitting on couch using laptop'}
        width="400"
        height="340"
        loading="lazy"
      />
    </div>
    <div class="cta-banner-content">
      <h2 class="cta-banner-title">
        {title || 'Find the Right Fit for Your Care'}
      </h2>
      <p class="cta-banner-desc">
        {description || 'Ready to begin your journey toward healing? Whether you’re facing emotional challenges or seeking spiritual guidance, we’re here to walk with you.'}
      </p>
      <p class="cta-banner-sub"><strong>{subDescription}</strong></p>
      <a href="https://cornerstonehealthalaska.org/contact/" class="btn-cta-orange" id="cta-book">BOOK AN APPOINTMENT</a>
      <a href="tel:907-522-7080" class="cta-phone">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        Counseling: (907) 522-7080
      </a>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background-image: url("/images/crnstnhealth-Hero-banner.png");
    background-position: center;
    background-size: cover;
    overflow: hidden;
    position: relative;
    height: 100%;
    padding: 80px 0;
    border-radius: 10px;
    margin: 0 24px;
  }

  .cta-banner-inner {
    margin: 0 auto;
    display: grid;
    width: 100%;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    min-height: 340px;
  }

  .cta-banner-image {
    position: relative;
    min-height: 340px;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .cta-banner-image img {
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: center top;
    border-radius: 0 200px 200px 0;
  }

  .cta-banner-content {
    padding: 48px;
    color: #fff;
  }

  .cta-banner-title {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(22px, 3.5vw, 56px);
    font-weight: 700;
    color: #fff;
    margin: 0 0 16px;
    line-height: 1.25;
  }

  .cta-banner-desc {
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255,255,255,0.85);
    margin: 0 0 12px;
  }

  .cta-banner-sub {
    font-size: 18px;
    color: rgba(255,255,255,0.9);
    margin: 0 0 24px;
  }

  .btn-cta-orange {
    display: inline-flex;
    align-items: center;
    background: #f36e24;
    color: #fff;
    text-decoration: none;
    font-family: 'Manrope', sans-serif;
    font-size: 16px;
    font-weight: 700;
    padding: 12px 28px;
    border-radius: 50px;
    letter-spacing: 0.5px;
    transition: background 0.2s, transform 0.15s;
  }

  .btn-cta-orange:hover { background: #e05c15; transform: translateY(-2px); }

  .cta-phone {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,0.9);
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    margin-top: 12px;
    transition: color 0.2s;
  }

  .cta-phone:hover { color: #f0c040; }

  @media (max-width: 768px) {
    .cta-banner-inner { grid-template-columns: 1fr; }
    .cta-banner-image { display: none; }
    .cta-banner-content { padding: 40px 24px; }
  }
</style>