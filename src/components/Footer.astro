              <rect x="30" width="26" height="26" fill="#1a6b72"/>
              <rect x="30" y="30" width="26" height="26" fill="#f36e24"/>
              <rect y="30" width="26" height="26" fill="#1a6b72"/>
            </svg>
          </div>
          <div class="footer-brand-text">
            <span class="brand-name">CORNERSTONE</span>
            <span class="brand-sub">H E A L T H</span>
          </div>
        </a>
      </div>

      <!-- Services -->
      <div class="footer-col">
        <h4 class="footer-heading">Services</h4>
        <ul class="footer-links">
          <li><a href="/services/counseling/">Counseling</a></li>
        </ul>
