      <!-- About -->
      <div class="footer-col">
        <h4 class="footer-heading">About</h4>
        <ul class="footer-links">
          <li><a href="/about/#mission">Mission</a></li>
          <li><a href="/about/#our-team">Our Team</a></li>
          <li><a href="/about/#our-providers">Our Providers</a></li>
          <li><a href="/about/#transparency-law">Transparency Law</a></li>
          <li><a href="/about/#client-privacy">Client Privacy</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div class="footer-col">
        <h4 class="footer-heading">Resources</h4>
        <ul class="footer-links">
          <li><a href="https://myupdox.com/portal/cornerstoneclinicmedicalcenter/html/index.html" target="_blank" rel="noopener">Patient Portal</a></li>
          <li><a href="/resources/#billing-payment">Billing &amp; Payment</a></li>
          <li><a href="/resources/#accepted-insurance">Accepted Insurance</a></li>
          <li><a href="/resources/#faqs">FAQs</a></li>
          <li><a href="/resources/#client-intake-forms">Client Intake Forms</a></li>
          <li><a href="/blog/">Blog</a></li>
        </ul>
      </div>

      <!-- Office Hours -->
      <div class="footer-col">
        <h4 class="footer-heading">Office Hours</h4>
        <div class="footer-hours">
          <p><strong>Counseling Services</strong></p>
          <p>M–Th: 9:00 AM – 5:00 PM</p>
          <p>F: 9:00 AM – 4:00 PM</p>
          <p>Sat: By Appointment Only</p>
          <p>Sun: Closed</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p class="footer-copyright">Copyright &copy; 2026 Cornerstone Health</p>
      <p class="footer-credit"><a href="https://www.beaconmm.com/" target="_blank" rel="noopener">Created by Beacon Media + Marketing</a></p>
      <nav class="footer-policy-links" aria-label="Policy links">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-services/">Terms &amp; Services</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    font-family: 'Manrope', sans-serif;
  }

  .footer-main {
    background: #0b2545;
    padding: 60px 0 40px;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 220px repeat(4, 1fr);
    gap: 40px;
    align-items: start;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 1px;
    line-height: 1.1;
  }

  .brand-sub {
    font-family: 'Manrope', sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: rgba(255,255,255,0.7);
    letter-spacing: 3px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-heading {
    font-family: 'Montserrat', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 4px;
    text-transform: none;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-links a {
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    font-size: 14px;
    font-weight: 400;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: #3ac1cd;
  }

  .footer-hours p {
    color: rgba(255,255,255,0.75);
    font-size: 14px;
    margin: 2px 0;
  }

  .footer-hours strong {
    color: #ffffff;
    font-weight: 600;
  }

  .footer-social {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: rgba(255,255,255,0.1);
    color: #ffffff;
    border-radius: 50%;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }

  .social-icon:hover {
    background: #3ac1cd;
    transform: scale(1.1);
  }

  /* Bottom bar */
  .footer-bottom {
    background: #091d37;
    padding: 16px 0;
  }

  .footer-bottom-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-copyright,
  .footer-credit {
    font-size: 13px;
    color: rgba(255,255,255,0.6);
    margin: 0;
  }

  .footer-credit a {
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-credit a:hover {
    color: #3ac1cd;
  }

  .footer-policy-links {
    margin-left: auto;
    display: flex;
    gap: 20px;
  }

  .footer-policy-links a {
    font-size: 13px;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-policy-links a:hover {
    color: #3ac1cd;
  }

  @media (max-width: 1024px) {
    .footer-inner {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .footer-policy-links {
      margin-left: 0;
    }
  }
</style>
