<style>
  .site-footer {
    font-family: 'Manrope', sans-serif;
    color: #ffffff;
  }

  .footer-main {
    background: #0b2545;
    padding: 60px 0 40px;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 300px repeat(4, 1fr);
    gap: 32px;
    align-items: start;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo-link img {
    max-width: 240px;
    height: auto;
  }

  .footer-tagline {
    font-size: 13px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .partner-logos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 8px;
  }

  .partner-logos-grid a {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 8px;
    transition: background 0.2s;
  }

  .partner-logos-grid a:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .partner-logos-grid img {
    max-width: 100%;
    max-height: 48px;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: opacity 0.2s;
  }

  .partner-logos-grid a:hover img {
    opacity: 0.9;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-heading {
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 4px;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-links a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: #3ac1cd;
  }

  .footer-hours p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 13px;
    line-height: 1.5;
    margin: 2px 0;
  }

  .footer-hours strong {
    color: #ffffff;
    font-weight: 600;
  }

  .footer-social {
    display: flex;
    gap: 10px;
    margin-top: 12px;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-radius: 50%;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }

  .social-icon:hover {
    background: #f36e24;
    transform: translateY(-2px);
  }

  /* Bottom bar */
  .footer-bottom {
    background: #071930;
    padding: 18px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-bottom-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer-copyright,
  .footer-credit {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  .footer-credit a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-credit a:hover {
    color: #3ac1cd;
  }

  .footer-policy-links {
    display: flex;
    gap: 20px;
  }

  .footer-policy-links a {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-policy-links a:hover {
    color: #3ac1cd;
  }

  @media (max-width: 1024px) {
    .footer-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }

    .footer-brand-col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
