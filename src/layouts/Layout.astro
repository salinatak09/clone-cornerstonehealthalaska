---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = "Home | CORNERSTONE HEALTH",
  description = "Faith-based counseling services in Anchorage offering support for individuals, couples, and families. Schedule an appointment today.",
  ogImage = "/images/Union.png",
  canonical = "https://cornerstonehealthalaska.org/",
} = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="profile" href="https://gmpg.org/xfn/11" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/health-fav-icon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/health-fav-icon.svg" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Share Cards -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="CORNERSTONE HEALTH" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="830" />
    <meta property="og:image:height" content="491" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://cornerstonehealthalaska.org/#organization",
            "name": "CORNERSTONE HEALTH",
            "url": "https://cornerstonehealthalaska.org/",
            "logo": {
              "@type": "ImageObject",
              "url": "/images/Cornerstone-Logo-White.svg"
            }
          },
          {
            "@type": "WebSite",
            "@id": "https://cornerstonehealthalaska.org/#website",
            "url": "https://cornerstonehealthalaska.org/",
            "name": "CORNERSTONE HEALTH",
            "publisher": { "@id": "https://cornerstonehealthalaska.org/#organization" }
          }
        ]
      }
    </script>

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-navy: #0b2545;
    --color-navy-dark: #093248;
    --color-teal: #1a6b72;
    --color-deep-teal: #006271;
    --color-light-teal: #3bc1cc;
    --color-orange: #f36e24;
    --color-orange-hover: #e05c15;
    --color-ice-blue: #f1f9fa;
    --color-text-slate: #5e6b71;
    --color-white: #ffffff;
    --font-heading: 'Montserrat', sans-serif;
    --font-body: 'Manrope', sans-serif;
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-slate);
    background: var(--color-white);
    -webkit-font-smoothing: antialiased;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    color: var(--color-navy);
  }

  /* Shared Container & Typography */
  .section-inner {
    /* max-width: 1200px; */
    margin: 0 auto;
    padding: 0 24px;
  }

  .eyebrow-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--color-orange);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .eyebrow-label.teal { color: var(--color-teal); }
  .eyebrow-label.centered { text-align: center; }

  .section-heading {
    font-family: var(--font-heading);
    font-size: clamp(26px, 3.5vw, 48px);
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 20px;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .section-heading.centered { text-align: center; }

  .section-subtext {
    font-size: 18px;
    color: var(--color-text-slate);
    line-height: 1.65;
    margin-bottom: 40px;
  }

  .section-subtext.centered { text-align: center; margin:auto}

  .body-text {
    font-size: 18px;
    line-height: 1.7;
    color: var(--color-text-slate);
    margin-bottom: 16px;
  }

  /* Shared Page Hero */
  .page-hero{
    position: relative;
    overflow: hidden;
    background-image: url("/images/crnstnhealth-Hero-banner.png");
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    width: 100%;
    min-height: 320px;
    height: auto;

    display: flex;
    align-items: center;
    gap: 40px;
    padding: 48px 24px;
  }

  .page-hero-inner{
    flex: 1;
    margin: 0 auto;
    padding: 10px 24px;
  }

  .page-hero-content{
    flex: 1;
    font-size: 22px;
    font-weight: 500;
    padding: 10px 24px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 500;
    font-family: var(--font-heading);
    color: #ffa150;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  
  .breadcrumb a {
    color: #ffa150;
    text-decoration: none;
    transition: color 0.2s;
  }

  .page-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4.2vw, 52px);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 12px;
    line-height: 1.15;
    letter-spacing: 1px;
  }

  .page-hero-desc {
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    max-width: 600px;
    line-height: 1.6;
    letter-spacing: 0.5px;
  }

  /* Shared Buttons */
  .btn-hero,
  .btn-orange-lg,
  .btn-cta-lg,
  .btn-cta-orange,
  .btn-view-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-orange);
    color: #ffffff !important;
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 700;
    border-radius: 50px;
    transition: background 0.2s, transform 0.15s;
    border: none;
    cursor: pointer;
  }

  .btn-hero {
    font-size: 15px;
    padding: 14px 32px;
    margin-top: 24px;
  }

  .btn-orange-lg {
    font-size: 14px;
    padding: 12px 28px;
    letter-spacing: 0.5px;
  }

  .btn-cta-lg {
    font-size: 16px;
    padding: 16px 40px;
  }

  .btn-cta-orange {
    font-size: 14px;
    padding: 12px 28px;
    letter-spacing: 0.5px;
  }

  .btn-view-more {
    font-size: 13px;
    padding: 10px 24px;
    letter-spacing: 0.5px;
  }

  .btn-hero:hover,
  .btn-orange-lg:hover,
  .btn-cta-lg:hover,
  .btn-cta-orange:hover,
  .btn-view-more:hover {
    background: var(--color-orange-hover);
  }

  /* Shared How It Works Section */
  .how-section {
    padding: 80px 0;
    background: #ffffff;
  }

  .how-inner {
    text-align: center;
  }

  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 20px;
  }

  .how-step {
    background: var(--color-ice-blue);
    border-radius: 16px;
    padding: 80px 32px 40px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    position: relative;
    margin-top: 48px;
  }

  .step-icon {
    position: absolute;
    top: -48px;
    left: 50%;
    transform: translateX(-50%);

    width: 90px;
    height: 90px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;
    background: #66cbd8;

    color: #002d55;
    font-size: 36px;
    font-weight: 700;
  }

  .step-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0;
  }

  .step-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-slate);
    margin: 0;
  }

  /* Shared Blog Card & Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .blog-card {
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
  }

  .blog-card-image-link img {
    width: 100%;
    height: 209px;
    object-fit: cover;
    object-position: center top;
    border-radius: 20px 20px 0 0;
    transition: transform 0.3s;
  }

  .blog-card:hover .blog-card-image-link img {
    transform: scale(1.03);
  }

  .blog-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .blog-category {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-slate);
    text-transform: uppercase;
  }

  .blog-date {
    font-family: var(--font-heading);
    font-size: 12px;
    color: #888;
  }

  .blog-card-title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.4px;
    color: var(--color-navy);
    margin: 0 0 24px;
    flex: 1;
  }

  .blog-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  .blog-card-title a:hover {
    color: var(--color-teal);
  }

  .read-more-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-orange);
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    transition: gap 0.2s;
    margin-top: auto;
  }

  .read-more-link:hover {
    gap: 12px;
  }

  /* Shared Legal Content */
  .legal-content-section {
    padding: 80px 0;
    background: #ffffff;
  }

  .legal-content {
    max-width: 800px;
    margin: 0 auto;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-slate);
  }

  .legal-content h2 {
    font-family: var(--font-heading);
    font-size: 28px;
    color: var(--color-navy);
    margin-top: 0;
  }

  .legal-content h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    color: var(--color-teal);
    margin-top: 32px;
  }

  .legal-content ul {
    padding-left: 20px;
  }

  .legal-content a {
    color: var(--color-orange);
    text-decoration: none;
  }

  .legal-content a:hover {
    text-decoration: underline;
  }

  /* Responsive Media Queries for Shared Components */
  @media (max-width: 1024px) {
    .how-steps {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 20px auto 0;
    }
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .cta-banner-inner {
      grid-template-columns: 280px 1fr;
    }
  }

  @media (max-width: 768px) {
    .testimonial-inner {
      grid-template-columns: 1fr;
    }
    .testimonial-image {
      display: none;
    }
    .testimonial-quote-wrap {
      padding: 40px 24px;
    }
    .blog-grid {
      grid-template-columns: 1fr;
    }
    .cta-banner-inner {
      grid-template-columns: 1fr;
    }
    .cta-banner-image {
      display: none;
    }
    .cta-banner-content {
      padding: 40px 24px;
    }
  }
</style>

